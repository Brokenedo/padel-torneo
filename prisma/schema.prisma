// Prisma schema per il gestionale torneo di padel.
// In sviluppo locale senza DATABASE_URL l'app usa un repository mock in-memory
// (vedi src/lib/data/index.ts): questo schema serve per la modalità "prisma" reale
// e per il deploy su Vercel con Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TournamentStatus {
  ACTIVE
  COMPLETED
}

enum RoundStatus {
  PENDING
  VALIDATED
}

// Modalita' di assegnazione punti individuali (classifica), scelta alla creazione del torneo.
// VOLLEYBALL: 2-0 => 3/0, 2-1 => 2/1 (stile pallavolo)
// WIN_ONLY: vittoria = 1 punto, sconfitta = 0, qualunque sia il risultato
// SETS_WON: punti = numero di set vinti da ciascuna squadra
enum ScoringMode {
  VOLLEYBALL
  WIN_ONLY
  SETS_WON
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String?  @unique
  email        String   @unique
  name         String
  passwordHash String
  // solo gli utenti con isAdmin=true vedono/accedono alla sezione di gestione utenti
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  tournaments Tournament[]
}

model Player {
  id        String   @id @default(cuid())
  name      String
  email     String?
  createdAt DateTime @default(now())

  tournamentPlayers TournamentPlayer[]
}

model Tournament {
  id                 String           @id @default(cuid())
  name               String
  startDate          DateTime
  status             TournamentStatus @default(ACTIVE)
  scoringMode        ScoringMode      @default(VOLLEYBALL)
  currentRoundNumber Int              @default(1)
  totalRounds        Int              @default(11)
  createdAt          DateTime         @default(now())
  // admin che ha creato il torneo: solo lui puo' eliminarlo
  createdById        String?
  createdBy          AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  players TournamentPlayer[]
  rounds  Round[]
}

// Un giocatore all'interno di un torneo specifico, con il numero 1-7 assegnato a sorteggio.
model TournamentPlayer {
  id           String  @id @default(cuid())
  tournamentId String
  playerId     String
  number       Int
  // preferenza espressa alla creazione del torneo: se true, l'algoritmo di
  // generazione del calendario cerca di non assegnargli partite in piu' degli altri
  // (vincolo "soft", non sempre rispettabile al 100% per vincoli matematici).
  avoidsExtraMatches Boolean @default(false)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, number])
  @@unique([tournamentId, playerId])
}

model Round {
  id            String      @id @default(cuid())
  tournamentId  String
  roundNumber   Int
  weekStartAt   DateTime
  status        RoundStatus @default(PENDING)
  // numeri (1-7) dei giocatori che riposano in questo turno (sempre 3 su 7)
  restingNumbers Int[]

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match      Match?

  @@unique([tournamentId, roundNumber])
}

model Match {
  id      String @id @default(cuid())
  roundId String @unique

  // numeri (1-7) dei giocatori, 2 per squadra
  team1Numbers Int[]
  team2Numbers Int[]

  winnerTeam Int?
  courtId    String?

  round Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  sets  MatchSet[]
  court Court?    @relation(fields: [courtId], references: [id])
}

model MatchSet {
  id         String @id @default(cuid())
  matchId    String
  setNumber  Int
  team1Games Int
  team2Games Int

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// Registro delle operazioni CRUD eseguite dagli utenti. Nessuna relazione verso
// AdminUser: i log devono restare anche se l'utente viene eliminato.
model AuditLog {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  userId     String?
  username   String
  action     AuditAction
  entityType String // es. "Tournament", "Player", "AdminUser", "Round"
  entityId   String?
  details    Json?

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Court {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  matches   Match[]
}

